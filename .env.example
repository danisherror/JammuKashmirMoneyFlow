# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jk_money_flow
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/jk_money_flow

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
SECRET_KEY=your-secret-key-here
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_ENABLED=true
MGNREGA_FETCH_HOUR=6
CGA_FETCH_DAY=26

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
