# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jk_money_flow
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/jk_money_flow

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
SECRET_KEY=your-secret-key-here
LOG_LEVEL=INFO
# Log every SQL statement from SQLAlchemy (very noisy; debugging only)
SQL_ECHO=false
# Load made-up budget allocations for local development (shown with a red DEMO DATA banner).
# The API refuses to start with DEMO_MODE=true when APP_ENV=production.
DEMO_MODE=false

# Scheduler
SCHEDULER_ENABLED=true
MGNREGA_FETCH_HOUR=6
CGA_FETCH_DAY=26

# Where saved source documents (PDFs etc.) are stored, relative to backend/
RAW_SNAPSHOT_DIR=raw_snapshots

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
